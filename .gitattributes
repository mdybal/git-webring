# Normalize line endings for text files.
* text=auto

# Keep these as LF regardless of host OS (important for JSON, JS, shell).
*.json text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Force binary for things that should never be normalized.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
